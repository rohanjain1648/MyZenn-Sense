# Copy this file to `.env` and fill in your keys. `.env` is git-ignored.

# Required for live camera signals.
# Get a free key at https://physiology.presagetech.com (Developer portal > Dashboard).
PRESAGE_API_KEY=

# Optional AI partner for MyStage Pulse. Off until you turn it on in Privacy & settings.
# Without any AI key, MyStage Pulse uses a built-in scripted partner (no AI service is contacted).

# Primary: Groq (https://console.groq.com/keys)
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Fallback: OpenAI, used only if Groq cannot answer (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
